{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "820px",
			"wideSize": "1100px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": true,
			"palette": [
				{ "slug": "ms-dark", "color": "#204B57", "name": "Hull Teal" },
				{ "slug": "ms-medium", "color": "#125E8A", "name": "Deep Channel" },
				{ "slug": "ms-bright", "color": "#197BBD", "name": "Bridge Blue" },
				{ "slug": "ms-taupe", "color": "#C2B8B2", "name": "Taupe" },
				{ "slug": "ms-white", "color": "#ffffff", "name": "White" },
				{ "slug": "ms-black", "color": "#0f1c20", "name": "Ink" },
				{ "slug": "surface-base", "color": "#f7f6f5", "name": "Surface" }
			]
		},
		"typography": {
			"fluid": false,
			"customFontSize": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{ "slug": "display", "name": "Outfit", "fontFamily": "'Outfit', sans-serif" },
				{ "slug": "body", "name": "Source Sans 3", "fontFamily": "'Source Sans 3', sans-serif" }
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.95rem", "name": "Small" },
				{ "slug": "medium", "size": "1.125rem", "name": "Medium" },
				{ "slug": "large", "size": "1.5rem", "name": "Large" },
				{ "slug": "x-large", "size": "2rem", "name": "Extra Large" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vh", "vw" ]
		}
	},
	"styles": {
		"color": {
			"background": "#ffffff",
			"text": "#204B57"
		},
		"typography": {
			"fontFamily": "'Source Sans 3', sans-serif",
			"fontSize": "1.125rem",
			"lineHeight": "1.7"
		},
		"elements": {
			"h1": {
				"typography": { "fontFamily": "'Outfit', sans-serif", "fontWeight": "700", "letterSpacing": "-0.03em", "lineHeight": "1.15" },
				"color": { "text": "#204B57" }
			},
			"h2": {
				"typography": { "fontFamily": "'Outfit', sans-serif", "fontWeight": "700", "letterSpacing": "-0.02em", "lineHeight": "1.2" },
				"color": { "text": "#204B57" }
			},
			"h3": {
				"typography": { "fontFamily": "'Outfit', sans-serif", "fontWeight": "600", "letterSpacing": "-0.01em" },
				"color": { "text": "#204B57" }
			},
			"h4": {
				"typography": { "fontFamily": "'Outfit', sans-serif", "fontWeight": "600" },
				"color": { "text": "#204B57" }
			},
			"link": {
				"color": { "text": "#197BBD" },
				":hover": { "color": { "text": "#125E8A" } }
			}
		}
	}
}
